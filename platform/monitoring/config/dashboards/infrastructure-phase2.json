 "panels": [
  {
   "type": "text",
   "title": "",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 3
   },
   "options": {
    "mode": "markdown",
    "content": "**Infrastructure (Phase 2)** 노드와 앱 Pod 의 CPU·메모리, 스케줄 가능성(CPU 요청률), 재시작·Pending. RDS(연결·CPU·크레딧)는 CloudWatch 연동(4단계, 선택) 후 이 대시보드에 추가한다 — 지금은 Prometheus 에 RDS 지표가 없다."
   },
   "id": 1
  },
  {
   "type": "timeseries",
   "title": "노드 CPU 사용률",
   "description": "",
   "gridPos": {
    "x": 0,
    "y": 3,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "expr": "1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[2m]))",
     "legendFormat": "{{instance}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "color": {
      "mode": "palette-classic-by-name",
      "fixedColor": "#2a78d6"
     },
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "pointSize": 4,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "none"
      },
      "thresholdsStyle": {
       "mode": "off"
      }
     },
     "min": 0,
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 2
  },
  {
   "type": "timeseries",
   "title": "노드 메모리 사용률",
   "description": "점선 90%.",
   "gridPos": {
    "x": 8,
    "y": 3,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "expr": "1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
     "legendFormat": "{{instance}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "color": {
      "mode": "palette-classic-by-name",
      "fixedColor": "#2a78d6"
     },
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "pointSize": 4,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "none"
      },
      "thresholdsStyle": {
       "mode": "dashed"
      }
     },
     "min": 0,
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "transparent",
        "value": null
       },
       {
        "color": "#d03b3b",
        "value": 0.9
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
