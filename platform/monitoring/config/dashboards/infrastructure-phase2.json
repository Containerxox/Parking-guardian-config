  {
   "type": "timeseries",
   "title": "Pending / NotReady Pod",
   "description": "Pending 이 10분 넘으면 알림 PGPodPending.",
   "gridPos": {
    "x": 0,
    "y": 19,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "expr": "sum(kube_pod_status_phase{namespace=\"parking-guardian\", phase=\"Pending\"}) or vector(0)",
     "legendFormat": "Pending",
     "refId": "A"
    },
    {
     "expr": "count(kube_pod_status_ready{namespace=\"parking-guardian\", condition=\"false\"} == 1) or vector(0)",
     "legendFormat": "NotReady",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "fixed",
      "fixedColor": "#2a78d6"
     },
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "pointSize": 4,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "none"
      },
      "thresholdsStyle": {
       "mode": "off"
      }
     },
     "min": 0,
     "decimals": 0
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Pending"
      },
      "properties": [
