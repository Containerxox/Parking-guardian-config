    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 3
  },
  {
   "type": "timeseries",
   "title": "노드 CPU 요청 / allocatable",
   "description": "스케줄러는 요청 합이 allocatable 을 넘는 노드에 Pod 를 올리지 않는다. 100% 근처에 새 Worker(요청 1코어)가 뜰 자리는 없다.",
   "gridPos": {
    "x": 16,
    "y": 3,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum by (node) (kube_pod_container_resource_requests{resource=\"cpu\"}) / on (node) kube_node_status_allocatable{resource=\"cpu\"}",
     "legendFormat": "{{node}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "color": {
      "mode": "palette-classic-by-name",
      "fixedColor": "#2a78d6"
