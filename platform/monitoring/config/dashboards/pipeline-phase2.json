     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 2
  },
  {
   "type": "timeseries",
   "title": "DLQ: SQS 메시지 vs DB dead_lettered 작업",
   "description": "Relay 가 DLQ 를 2초마다 읽어 작업을 dead_lettered 로 옮기고 메시지를 지운다. SQS 쪽은 거의 항상 0 이고, 지속 신호는 DB 의 dead_lettered(재처리 전까지 남음). 알림 PGDLQHasMessages 는 둘 중 하나라도 > 0 이 1분.",
   "gridPos": {
    "x": 8,
    "y": 4,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum(max by (state) (pg_queue_messages{queue=\"dlq\"}))",
     "legendFormat": "SQS DLQ 메시지(대기+처리 중+지연)",
     "refId": "A"
    },
    {
     "expr": "max(pg_jobs{status=\"dead_lettered\"})",
     "legendFormat": "DB dead_lettered 작업(지속)",
