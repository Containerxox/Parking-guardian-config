     "expr": "histogram_quantile(0.95, sum by (le) (rate(pg_inference_stage_seconds_bucket{stage=\"decode\"}[1m])))",
     "legendFormat": "디코드",
     "refId": "A"
    },
    {
     "expr": "histogram_quantile(0.95, sum by (le) (rate(pg_inference_stage_seconds_bucket{stage=\"window\"}[1m])))",
