# Terraform 출력값 → ConfigMap backend-config. 실제 파일 config.env 는 .gitignore 대상이다.
# scripts/export-config-env.py 가 infra 리포의 `terraform output -json`(data, cluster)에서 만든다. 손으로 채워도 된다.
# 키 이름은 infra 리포와의 계약이다(architecture.md 6절). 바꾸면 양쪽을 같이 고친다.

# --- backend 가 읽는 값 (config.py) ---
AWS_REGION=ap-northeast-2
DB_HOST=parking-guardian.xxxxxxxxxxxx.ap-northeast-2.rds.amazonaws.com   # data: db_host
DB_PORT=5432                                                            # data: db_port
DB_NAME=parking_guardian                                                # data: db_name
S3_BUCKET=parking-guardian-photos-123456789012                          # data: photos_bucket_name
CORS_ORIGINS=https://parking.example.com                                # https://<data: app_fqdn>

# --- initContainer 가 읽는 값 ---
MODELS_BUCKET=parking-guardian-models-123456789012                      # data: models_bucket_name
MODEL_VERSION=v1                                                        # 버킷 안 접두어. 모델 교체 때 v2 로

# --- 매니페스트 안의 자리를 kustomize replacements 가 채우는 값 (Pod 에도 환경변수로 들어가지만 쓰이지 않는다) ---
ECR_BACKEND=123456789012.dkr.ecr.ap-northeast-2.amazonaws.com/parking-guardian/backend     # data: ecr_repository_urls.backend
ECR_FRONTEND=123456789012.dkr.ecr.ap-northeast-2.amazonaws.com/parking-guardian/frontend   # data: ecr_repository_urls.frontend
APP_HOST=parking.example.com                                            # data: app_fqdn → Ingress host
ACM_CERTIFICATE_ARN=arn:aws:acm:ap-northeast-2:123456789012:certificate/xxxxxxxx   # data: acm_certificate_arn → Ingress
SECRET_NAME_APP=parking-guardian/app                                    # data: secret_names.app → ExternalSecret
SECRET_NAME_SEED=parking-guardian/seed                                  # data: secret_names.seed → ExternalSecret
RDS_SECRET_ARN=arn:aws:secretsmanager:ap-northeast-2:123456789012:secret:rds!db-xxxxxxxx   # data: db_master_secret_arn → ExternalSecret
